{
    "name": "elf/archive",
    "description": "ELF Digital Historical Archive (PHP edition): people, families, places, events, sources, photographs and oral histories, with editorial review, an interactive historical map and a timeline.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "ext-pdo_sqlite": "*",
        "ext-gd": "*",
        "ext-mbstring": "*",
        "ext-intl": "*",
        "ext-json": "*",
        "ext-fileinfo": "*",
        "twig/twig": "^3.14",
        "phpmailer/phpmailer": "^6.9",
        "chillerlan/php-qrcode": "^5.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": { "Elf\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Elf\\Tests\\": "tests/" }
    },
    "config": {
        "platform": { "php": "8.1.0" },
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "scripts": {
        "test": "phpunit"
    }
}
