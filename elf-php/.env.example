# Copy to .env in this folder (never publish .env; it lives outside the public/ web folder). Safe placeholders below.
# The same ELF_* settings as the Python edition. Real environment variables, if set, take precedence over this file.

# development | testing | production. Production refuses to start without a strong secret and an https base URL.
ELF_ENV=development

# Random value of at least 32 characters. Generate one with:
#   php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
ELF_SECRET_KEY=replace-with-a-long-random-value

# SQLite database file. Relative paths are relative to this folder. Keep it outside public/ and back it up.
ELF_DATABASE_PATH=instance/archive.db

# Public address of the site, used in emails, canonical links, the sitemap and exports.
ELF_BASE_URL=http://localhost:8000
ELF_SITE_NAME=ELF Digital Historical Archive
ELF_CONTACT_EMAIL=

# Number of reverse proxies or CDNs in front of PHP: 0 on ordinary shared hosting, 1 behind one proxy (e.g. Cloudflare).
# Needed so sign-in lockouts and rate limits apply per visitor. Never set it higher than the real number of proxies.
ELF_TRUSTED_PROXIES=0

# Accounts
ELF_REQUIRE_EMAIL_VERIFICATION=true
ELF_ALLOW_SELF_REVIEW=false
ELF_SESSION_LIFETIME_SECONDS=604800
# Staff (editors, moderators, researchers, administrators) must turn on two-step sign-in before using staff tools.
ELF_REQUIRE_STAFF_MFA=false

# Email (optional until launch). Without it, mail is queued in the database; in development read it at /dev/outbox.
# Queued mail is sent by `php bin/elf send-email` (run it every few minutes from cron; see docs/DEPLOYMENT.md).
# Port 587 uses STARTTLS, port 465 uses TLS.
ELF_SMTP_HOST=
ELF_SMTP_PORT=587
ELF_SMTP_USER=
ELF_SMTP_PASSWORD=
ELF_SMTP_FROM=

# Uploaded files. Stored on disk OUTSIDE public/ and only ever served through the access-checking /media route.
# Back this folder up together with the database.
ELF_MEDIA_ROOT=instance/media
ELF_MAX_PHOTO_MB=15
ELF_MAX_DOCUMENT_MB=30
ELF_MAX_AV_MB=250
ELF_MAX_PHOTOS_PER_SUBMISSION=10

# Optional street-level map layer above the archive's own Eritrea base map. Empty = no third-party map service.
# Example (respect the provider's usage policy): https://tile.openstreetmap.org/{z}/{x}/{y}.png
ELF_MAP_TILE_URL=
ELF_MAP_TILE_ATTRIBUTION=

# Sites allowed to show the map and timeline inside their pages (e.g. the organization's WordPress site).
# Space-separated https origins. Empty = no other site may embed anything. See docs/DEPLOYMENT.md.
ELF_EMBED_ORIGINS=

# Database updates when the site starts: on by default in development only. In production leave it off and run
# `php bin/elf migrate` after a backup.
# ELF_AUTO_MIGRATE=false

# Where compiled templates are kept in production (must be writable by PHP).
ELF_TEMPLATE_CACHE=instance/cache/twig
