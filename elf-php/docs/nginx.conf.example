# nginx + PHP-FPM for the PHP edition. Replace archive.example.org and the paths.
# Only the public/ folder is served; settings (.env), the database and uploads stay outside it.
server {
    listen 443 ssl http2;
    server_name archive.example.org;
    root /srv/elf-php/public;
    index index.php;

    ssl_certificate     /etc/letsencrypt/live/archive.example.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/archive.example.org/privkey.pem;

    # uploads: keep in step with ELF_MAX_AV_MB (+2 MB for the form)
    client_max_body_size 252m;

    # styles, scripts and map tiles straight from disk
    location /static/ {
        add_header X-Content-Type-Options nosniff always;
        if ($arg_v) { add_header Cache-Control "public, max-age=31536000, immutable" always; }
        try_files $uri =404;
    }

    location / {
        try_files $uri /index.php$is_args$args;
    }

    location = /index.php {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root/index.php;
        fastcgi_pass unix:/run/php/php8.3-fpm.sock;
        # large audio and video uploads
        fastcgi_read_timeout 300;
    }

    # nothing else that ends in .php, and no hidden files
    location ~ \.php$ { return 404; }
    location ~ /\. { return 404; }
}

server {
    listen 80;
    server_name archive.example.org;
    return 301 https://$host$request_uri;
}
