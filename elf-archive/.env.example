# Copy to .env (never commit .env). All values below are safe placeholders.
# On a server, use plain KEY=value lines without quotes (systemd reads this file). See docs/DEPLOYMENT.md.

# development | testing | production. Production refuses to start without a strong secret and an https base URL.
ELF_ENV=development

# Random value of at least 32 characters. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
ELF_SECRET_KEY=replace-with-a-long-random-value

# SQLite database file. Keep it outside the web root and back it up (see docs/OPERATIONS.md).
ELF_DATABASE_PATH=instance/archive.db

# Public address of the site, used in emails, canonical links, the sitemap and exports.
ELF_BASE_URL=http://localhost:5000
ELF_SITE_NAME=ELF Digital Historical Archive
ELF_CONTACT_EMAIL=

# Number of reverse proxies (nginx, Caddy) in front of the app: 1 on a normal server, 0 when running it directly.
# Needed so sign-in lockouts and rate limits apply per visitor. Never set it higher than the real number of proxies.
ELF_TRUSTED_PROXIES=0

# Accounts
ELF_REQUIRE_EMAIL_VERIFICATION=true
ELF_ALLOW_SELF_REVIEW=false
ELF_SESSION_LIFETIME_SECONDS=604800
# Staff (editors, moderators, researchers, administrators) must turn on two-step sign-in before using staff tools.
ELF_REQUIRE_STAFF_MFA=false

# Email (optional until launch). Without it, mail is queued in the database; in development read it at /dev/outbox.
ELF_SMTP_HOST=
ELF_SMTP_PORT=587
ELF_SMTP_USER=
ELF_SMTP_PASSWORD=
ELF_SMTP_FROM=

# Uploaded files. Stored on local disk OUTSIDE the web-served folder and only ever served through the
# access-checking /media route. Back this folder up together with the database (docs/OPERATIONS.md).
ELF_MEDIA_ROOT=instance/media
ELF_MAX_PHOTO_MB=15
ELF_MAX_DOCUMENT_MB=30
ELF_MAX_AV_MB=250
ELF_MAX_PHOTOS_PER_SUBMISSION=10

# Optional street-level map layer above the archive's own Eritrea base map. Empty = no third-party map service.
# Example (respect the provider's usage policy): https://tile.openstreetmap.org/{z}/{x}/{y}.png
ELF_MAP_TILE_URL=
ELF_MAP_TILE_ATTRIBUTION=

# Sites allowed to show the map and timeline inside their pages (e.g. the organization's WordPress site).
# Space-separated https origins. Empty = no other site may embed anything. See docs/DEPLOYMENT.md §13.
ELF_EMBED_ORIGINS=

# Applies migrations when the app starts. Leave off in production; run `flask --app elf_archive migrate` instead.
ELF_AUTO_MIGRATE=false
